    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "csv-parse": "^6.2.1",
    "gh-pages": "^6.2.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.15",
    "vite": "^8.1.0",
    "vite-node": "^6.0.0"
  }
