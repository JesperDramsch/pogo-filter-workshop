{
  "name": "pogo-filter-workshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch-translations": "node scripts/fetch-translations.mjs",
    "fetch-raid-bosses": "node scripts/fetch-raid-bosses.mjs",
    "fetch-events": "node scripts/fetch-events.mjs",
    "fetch-rocket-lineups": "node scripts/fetch-rocket-lineups.mjs",
    "fetch-rocket-grunt-quotes": "node scripts/fetch-rocket-grunt-quotes.mjs",
    "fetch-pvp-rankings": "node scripts/fetch-pvp-rankings.mjs",
    "fetch-meta-rankings": "node scripts/fetch-meta-rankings.mjs",
    "fetch-evolution-costs": "node scripts/fetch-evolution-costs.mjs",
    "fetch-regional-forms": "node scripts/fetch-regional-forms.mjs",
    "generate-pwa-assets": "pwa-assets-generator",
    "prebuild": "node scripts/fetch-translations.mjs --offline-ok && node scripts/fetch-raid-bosses.mjs --offline-ok && node scripts/fetch-rocket-lineups.mjs --offline-ok && node scripts/fetch-rocket-grunt-quotes.mjs --offline-ok && node scripts/fetch-pvp-rankings.mjs --offline-ok && node scripts/fetch-meta-rankings.mjs --offline-ok && node scripts/fetch-evolution-costs.mjs --offline-ok && node scripts/fetch-events.mjs --offline-ok && node scripts/fetch-regional-forms.mjs --offline-ok",
    "build": "vite build",
    "test:fixtures": "vite-node scripts/check-fixtures.mjs",
    "test:migration": "vite-node scripts/check-import-migration.mjs",
    "test:buddy": "vite-node scripts/check-buddy-catch.mjs",
    "test:regionals": "vite-node scripts/verify-regionals.mjs",
